OPENING_CREDITS
SCREENPLAY

CHARACTER @hero
RATING @rating <- 4

FUNCTION @awardScore(RATING @rating) RETURNS RATING FRAME
RETURN @rating + 1
ENDFRAME ENDFUNCTION

SCENE_IF (@awardScore(@rating) GREATER_THAN 3) FRAME
AWARD "Best Film"
ENDFRAME
OTHERWISE FRAME
REVIEW "Average Film"
ENDFRAME

ENDSCREENPLAY
FINAL_CREDITS
