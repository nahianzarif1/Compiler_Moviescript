OPENING_CREDITS
SCREENPLAY

// --check reports all these semantic errors and never executes PRINT.
RATING @score <- 5.1
BUDGET @budget <- -1
WHOLE @count <- 2.5
CHARACTER @director <- 42
STATUS @release <- "SUCCESS"
SIGNAL @ready <- 1
@missing <- 3
PRINT "This program must never execute"

ENDSCREENPLAY
FINAL_CREDITS
