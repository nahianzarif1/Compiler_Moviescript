OPENING_CREDITS
SCREENPLAY

RATING @rating <- 11

FUNCTION @score(RATING @rating) RETURNS RATING FRAME
RETURN @rating + 1
ENDFRAME ENDFUNCTION

SCENE_IF (@score(@rating) GREATER_THAN 8) FRAME
AWARD "Top Rated"
ENDFRAME
OTHERWISE FRAME
REVIEW "Average"
ENDFRAME

WHILE (@rating GREATER_THAN 8) TAKE
@rating <- 7
BUILD_SUSPENSE
PRINT @rating
ENDTAKE

ENDSCREENPLAY
FINAL_CREDITS
